# V1 demonstration environment
# Set concrete values in an untracked .env file before Phase 1 services are started.
POSTGRES_DB=shelter_demo
POSTGRES_USER=shelter_app
POSTGRES_PASSWORD=shelter_demo_password
DATABASE_URL=postgresql://shelter_app:shelter_demo_password@postgres:5432/shelter_demo
API_HOST=127.0.0.1
API_PORT=3000
FRONTEND_PORT=8080
API_BASE_URL=/api
APP_ENV=development
